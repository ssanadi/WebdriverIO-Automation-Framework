# Environment Configuration
# Copy this file to .env and fill in your actual values

# Environment to use (dev, qa, prod)
ENVIRONMENT=qa

# RudderStack Login Credentials
RUDDERSTACK_USERNAME=exampleuser@example.com
RUDDERSTACK_PASSWORD=ExamplePass123
RUDDERSTACK_BASE_URL=https://app.rudderstack.com

# RudderStack Configuration
RUDDERSTACK_WRITE_KEY=EXAMPLE_WRITE_KEY_12345
RUDDERSTACK_DATA_PLANE_URL=https://exampledataplane.rudderstack.com

# API Configuration
API_TIMEOUT=60000
WEBHOOK_TIMEOUT=60000

# Webhook Configuration
WEBHOOK_BASE_URL=https://example.requestcatcher.com

# Browser Configuration
BROWSER_HEADLESS=false
BROWSER_TIMEOUT=120000
BROWSER_WIDTH=1920
BROWSER_HEIGHT=1080

# Test Configuration
TEST_TIMEOUT=120000